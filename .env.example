# Необязательно. Если не задано, используется боевая база из src/supabase.ts.
# Скопируй этот файл в .env и укажи ТЕСТОВЫЙ проект Supabase для разработки и e2e-проверки,
# чтобы не создавать тестовых пользователей в боевой базе.
VITE_SUPABASE_URL=https://your-test-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-test-project-anon-key
